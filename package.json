{
  "name": "webhooks",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NuovarDev/HookHQ"
  },
  "homepage": "https://hookhq.dev",
  "description": "Webhooks-as-a-service application built with Cloudflare Workers",
    "scripts": {
    "clean": "rm -rf .open-next && rm -rf .wrangler && rm -rf node_modules && rm -rf .next",
    "clean-deploy": "pnpm clean && pnpm i && pnpm run deploy",
    "dev": "wrangler d1 migrations apply DATABASE --local && next dev --turbopack",
    "dev:worker": "wrangler dev",
    "dev:proxy-relay": "node proxy-relay/server.mjs",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "start": "next start",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "deploy": "opennextjs-cloudflare build && npx wrangler d1 migrations apply DATABASE --remote; opennextjs-cloudflare deploy",
    "dev:landing": "pnpm --dir landing dev",
    "build:landing": "pnpm --dir landing build",
    "start:landing": "pnpm --dir landing start",
    "deploy:landing": "pnpm --dir landing run deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "auth:generate": "npx --yes @better-auth/cli@latest generate --config src/auth/schema.ts --output src/db/auth.schema.ts -y",
    "auth:format": "npx --yes prettier --write src/db/auth.schema.ts",
    "auth:update": "npm run auth:generate && npm run auth:format",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "wrangler d1 migrations apply DATABASE --local",
    "db:migrate:prod": "wrangler d1 migrations apply DATABASE --remote",
    "db:studio:dev": "drizzle-kit studio",
    "db:studio:prod": "NODE_ENV=production drizzle-kit studio",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@headlessui/react": "^2.2.10",
    "@hono/zod-openapi": "^1.2.3",
    "@monaco-editor/loader": "^1.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@sagi.io/workers-jwt": "^0.0.26",
    "@scalar/hono-api-reference": "^0.10.20",
    "@smithy/signature-v4": "^5.3.12",
    "@tanstack/react-table": "^9.3.1",
    "@types/jsonwebtoken": "^9.0.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-auth": "^1.3.34",
    "better-auth-cloudflare": "0.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.12.8",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.3",
    "liquidjs": "^10.30.1",
    "lucide-react": "^0.509.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.2.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.975.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.11",
    "@types/ms": "^2.1.0",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.162.0"
  },
  "cloudflare": {
    "bindings": {
      "AUTH_SECRET": {
        "description": "Generate a random string using `openssl rand -base64 32`. Required."
      },
      "DESTINATION_ENCRYPTION_KEY": {
        "description": "Generate a random string using `openssl rand -base64 32`. Required."
      },
      "NEXT_PUBLIC_API_DOCS_ENABLED": {
        "description": "Whether to enable public API docs at /api/v1/ui and /api/v1/spec. Default is 'true'."
      },
      "JWT_PREFIX": {
        "description": "Prefix of the JWT issuer / audience. Default is 'hookhq'."
      }
    }
  }
}
